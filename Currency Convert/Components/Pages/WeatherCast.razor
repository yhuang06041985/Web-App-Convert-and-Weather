    private void SearchLocations()
    {
        _logger.LogInformation("SearchLocations fired: {Location}", locationStr);

        if (string.IsNullOrWhiteSpace(locationStr))
        {
          searchLocations.Clear();
          return;
        }

        searchLocations = _dbContext.WorldCities
        .AsNoTracking()
        .Where(c => c.City.StartsWith(locationStr))
        .Take(10)
        .ToList();
    }

    private void SelectLocation(WorldCity location)
    {
        locationStr = $"{location.City}, {location.State}, {location.Country}";

        searchLocations.Clear();
    }


    private async Task GetWeather()
    {
        if (string.IsNullOrWhiteSpace(locationStr))
        {
          _logger.LogWarning("City name is empty.");
          return;
        }

        var parts = locationStr.Split(',');

        var city = parts[0].Trim();

        var state = parts.Length > 1
          ? parts[1].Trim()
          : string.Empty;

        var country = parts.Length > 2
          ? parts[2].Trim()
          : string.Empty;

        var selectedLocation = _dbContext.WorldCities
    .FirstOrDefault(c =>
        c.City == city &&
        c.State == state &&
        c.Country == country);


        if (selectedLocation == null)
        {
    _logger.LogWarning(
        "Location not found: {City}, {State}",
        city,
        state);

    return;
        }


        forecastDto = await _weatherCastService.GetWeatherAsync(
    selectedLocation.Latitude,
    selectedLocation.Longitude);
            var test = "";
    }
}
